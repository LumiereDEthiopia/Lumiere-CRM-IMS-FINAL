# Server Configuration
PORT=3001
# development | production — production enables the strict CSP and requires
# CORS_ORIGIN when the client is hosted on a different origin.
NODE_ENV=development

# Public URL of this service. Used for startup logs only, never for routing.
# PUBLIC_URL=https://your-service.up.railway.app

# --- Serving the client ------------------------------------------------------
# When a client build exists (client/dist) this server serves it too, so the app
# and the API share ONE origin — no CORS and no VITE_API_URL required.
# SERVE_CLIENT=false            API only
# CLIENT_DIST=/app/client/dist  override the build location
SERVE_CLIENT=true
# TRUST_PROXY=false             stop trusting X-Forwarded-For (rate-limit keying)

# --- CORS (only needed when the client is hosted separately) -----------------
# Comma separated list, simple wildcards allowed:
# CORS_ORIGIN=https://lumiere-crm.vercel.app,https://*.vercel.app
CORS_ORIGIN=

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Previous SQLite configuration (source of the PostgreSQL migration; kept for reference):
# DATABASE_URL="file:./dev.db"

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here
R2_ENDPOINT=https://your_account_id_here.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-url.r2.dev

# Ethiopian eTrade — official Online Trade Registration & License System
# (https://etrade.gov.et/business-license-checker)
#
# The backend calls the same public JSON endpoint the government checker page
# uses. No credentials, cookies or API keys are required, and the cashier's
# browser never talks to eTrade — only the backend does. Every value below is
# optional and falls back to the default shown here.
ETRADE_BASE_URL=https://etrade.gov.et
ETRADE_CHECKER_PATH=/api/Registration/GetRegistrationInfoByTin
ETRADE_CHECKER_REFERER=https://etrade.gov.et/business-license-checker
ETRADE_LANGUAGE=en
# Hard per-request timeout for the government service (ms)
ETRADE_TIMEOUT_MS=10000
# Cache lifetime for a verification result, in hours
ETRADE_CACHE_TTL_HOURS=72
# Circuit breaker: stop calling eTrade after N consecutive failures, for this long
ETRADE_MAX_CONSECUTIVE_FAILURES=3
ETRADE_CIRCUIT_OPEN_MS=30000
# Pinned issuing CA for etrade.gov.et (their server omits the intermediate CA,
# which breaks Node's TLS chain building). Refresh it with:
#   cd server && node scripts/refresh-etrade-cert.mjs
ETRADE_EXTRA_CA_FILE=./certs/etrade-chain.pem
# Max TIN verifications per minute, per client IP
TIN_VERIFY_RATE_LIMIT_MAX=12

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_PREFIX=backups/database/
BACKUP_ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars
